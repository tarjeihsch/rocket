BasedOnStyle: LLVM
AllowShortFunctionsOnASingleLine: None

# Indentation
IndentWidth: 4
UseTab: Never

# Braces style
BreakBeforeBraces: Allman

# Allow long lines
ColumnLimit: 480

# Keep parameters on same line if they fit
AllowAllParametersOfDeclarationOnNextLine: true
BinPackParameters: true
BinPackArguments: true

# Optional: Avoid breaking after return types
AlwaysBreakAfterReturnType: None
AccessModifierOffset: -4

# Keeps * and & next to the variable name
PointerAlignment: Right
ReferenceAlignment: Right

# Prevents weird breaks between return type and name
AlwaysBreakAfterDefinitionReturnType: None

# Optional: Enforce alignment across declarations uniformly
DerivePointerAlignment: false